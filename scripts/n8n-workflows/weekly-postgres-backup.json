      "parameters": {
        "jsCode": "// Get the log result\nconst logResult = $('Log Backup Success').first().json;\n\n// Build notification\nconst title = '✅ TML Weekly Postgres Sync Complete';\nconst message = `Backup Log ID: ${logResult.id || 'N/A'}\\nTime: ${new Date().toLocaleTimeString('en-US', {hour: 'numeric', minute: '2-digit', hour12: true})}\\n\\n12 tables synced to Orange Pi backup DB`;\n\nreturn [{\n  json: {\n    topic: 'tml-backup',\n    title: title,\n    message: message,\n    priority: 3,\n    tags: ['white_check_mark', 'floppy_disk'],\n    click: 'https://n8n2.mattmariani.com'\n  }\n}];"
      },
