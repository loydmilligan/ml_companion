      "id": "merge-all",
      "name": "Merge All",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [500, 400]
    },
    {
      "parameters": {
        "jsCode": "// Combine all table exports into single backup object\nconst backup = {\n  backup_date: new Date().toISOString(),\n  backup_type: 'daily_json',\n  tables: {}\n};\n\nfor (const item of $input.all()) {\n  const result = item.json.result;\n  if (result && result.table) {\n    backup.tables[result.table] = {\n      exported_at: result.exported_at,\n      record_count: result.data ? result.data.length : 0,\n      data: result.data || []\n    };\n  }\n}\n\nreturn [{ json: backup }];"
      },
      "id": "build-backup",
      "name": "Build Backup JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO json_backups (backup_date, backup_data) VALUES (NOW(), $1::jsonb) RETURNING id, backup_date",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json) }}"
        }
      },
      "id": "save-to-db",
      "name": "Save to Backup DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [920, 400],
      "credentials": {
        "postgres": {
          "name": "TML_backup_DB"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-success",
              "leftValue": "={{ $json.tables }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-success",
      "name": "Check Success",
