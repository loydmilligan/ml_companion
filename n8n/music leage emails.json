      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1e83b07-efde-49be-baec-272d3dc889fe",
              "name": "league_name",
              "value": "={{ $json.headers.subject.replace(/^Subject:\\s*/i, \"\").split(\" - \")[0].trim() }}",
              "type": "string"
            },
            {
              "id": "f23093f9-9172-469b-a893-5dc2933c2600",
              "name": "event_type",
              "value": "={{\n    /Round Starting/i.test($json.headers.subject) || /open and ready for song submissions/i.test($json.html)\n      ? \"round_start\"\n      : /New Playlist/i.test($json.headers.subject) || /Playlist is Ready/i.test($json.html)\n      ? \"playlist_ready\"\n      : /Votes Are In/i.test($json.headers.subject) || /Results are in/i.test($json.html)\n      ? \"votes_in\"\n      : /User Submitted/i.test($json.headers.subject) || /has submitted a song/i.test($json.html)\n      ? \"user_submitted\"\n      : /User Voted/i.test($json.headers.subject) || /has cast their votes/i.test($json.html)\n      ? \"user_voted\"\n      : /Joined Your League/i.test($json.headers.subject) || /has joined your league/i.test($json.html)\n      ? \"user_joined\"\n      : \"unknown\"\n  }}",
              "type": "string"
            },
            {
              "id": "e5a9c75d-fe8b-42f4-9a15-b80e22da3404",
              "name": "round_name",
              "value": "={{\n    (function () {\n      const subject = ($json.headers?.subject || \"\").toLowerCase();\n      const html = $json.html || \"\";\n      const text = $json.text || \"\";\n\n      const isPlaylist = subject.includes(\"new playlist\") || /playlist is ready/i.test(html);\n      const isRoundStart = subject.includes(\"round starting\") || /open and ready for song submissions/i.test(html);\n\n      if (isPlaylist) {\n        const m = html.match(/The playlist for the <b>([^<]+)<\\/b> round of the <b>[^<]+<\\/b> league/i);\n        return m ? m[1].trim() : null;\n      }\n\n      if (isRoundStart) {\n        const cleaned = html\n          .replace(/<style[\\s\\S]*?<\\/style>/gi, \" \")\n          .replace(/<script[\\s\\S]*?<\\/script>/gi, \" \")\n          .replace(/<[^>]+>/g, \" \")\n          .replace(/\\s+/g, \" \")\n          .trim();\n        const m = cleaned.match(/The (.+?) round of the .+? league is open/i);\n        return m ? m[1].trim() : null;\n      }\n\n      const m = text.match(/round\\s+(.+?)!$/i);\n      return m ? m[1].trim() : null;\n    })()\n  }}",
              "type": "string"
            },
            {
              "id": "6de76cac-ef07-4e2f-ab70-d7aaa27696d9",
              "name": "actor_name",
              "value": "={{ ($json.text.match(/^User\\s+(.+?)\\s+just\\s+(?:submitted|voted)/i) || [])[1] || null }}",
              "type": "string"
            },
            {
              "id": "147058e9-758b-4fcd-b87b-78e954d72f47",
              "name": "playlist_url",
              "value": "={{\n    (function () {\n      const m = $json.html.match(/https?:\\/\\/[^\"']*open\\.spotify\\.com%2Fplaylist%2F[0-9A-Za-z]+/i);\n      if (!m) return null;\n      return decodeURIComponent(m[0].replace(/^https?:\\/\\/[^/]+\\/L0\\//i, \"\"));\n    })()\n  }}",
              "type": "string"
            },
            {
              "id": "05380eaf-7024-46cc-82e0-c7746d134261",
              "name": "id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "ba0ee56d-91cb-4161-9cd4-b2335cf7d913",
              "name": "threadId",
              "value": "={{ $json.threadId }}",
              "type": "string"
            },
            {
              "id": "f4ee3e0b-64f4-4b30-95f2-5b6a3fdce9ee",
              "name": "from",
              "value": "={{ ($json.from.text.match(/<([^>]+)>/) || [])[1] || $json.from.text }}",
              "type": "string"
            },
            {
              "id": "5572ae1a-39ad-4b11-829c-57ae7f2d70f9",
              "name": "to",
              "value": "={{ ($json.to.text.match(/<([^>]+)>/) || [])[1] || $json.to.text }}",
              "type": "string"
            },
            {
              "id": "80edfddd-0d06-4128-9665-b7135c947f0b",
              "name": "text",
              "value": "={{ $json.text }}",
              "type": "string"
            },
            {
              "id": "a82679b8-b950-4918-935c-592ae1d02860",
              "name": "received_at",
              "value": "={{ $json.date }}",
              "type": "string"
            }
          ]
        },
